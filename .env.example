###############################################################################
#  TrophyTracker — configuration
#
#  1. Générez votre fichier .env avec des secrets aléatoires :
#        sh scripts/init-env.sh
#  2. Adaptez la section « URLs » (et SMTP en production).
#
#  ⚠️ Ne commitez JAMAIS le fichier .env (il est dans .gitignore).
#  Les valeurs "CHANGE_ME" sont remplacées automatiquement par init-env.sh.
###############################################################################


############################################
# URLs — à adapter à votre domaine
############################################

# Adresse du site. En local : http://localhost:8088 (voir WEB_HTTP_PORT)
SITE_URL=http://localhost:8088
# Pause du service : « true » = le public ne voit qu'une page « pause » (comptes et données conservés,
# démo, relances et synchronisation GPS arrêtées). Accès direct au serveur (tunnel SSH) inchangé.
SITE_PAUSED=false
# Le site et l'API Supabase partagent la même adresse (Caddy redirige /auth, /rest…)
SUPABASE_PUBLIC_URL=http://localhost:8088
API_EXTERNAL_URL=http://localhost:8088/auth/v1
# Autres URLs autorisées après connexion / clic dans un email (séparées par des virgules)
ADDITIONAL_REDIRECT_URLS=http://localhost:5173/**,http://localhost:8088/**

# Adresse écoutée par Caddy :
#   - en local        : SITE_ADDRESS=:80   (HTTP simple)
#   - en production   : SITE_ADDRESS=trophytracker.fr   (HTTPS Let's Encrypt automatique)
SITE_ADDRESS=:80
# Ports publiés sur la machine (en production : 80 et 443)
WEB_HTTP_PORT=8088
WEB_HTTPS_PORT=8443


############################################
# Secrets — générés par scripts/init-env.sh
############################################

POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Clés API (jetons JWT signés avec JWT_SECRET). ANON_KEY est publique (utilisée par le site),
# SERVICE_ROLE_KEY contourne toute la sécurité : ne jamais l'exposer.
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME
SECRET_KEY_BASE=CHANGE_ME
REALTIME_DB_ENC_KEY=CHANGE_ME
VAULT_ENC_KEY=CHANGE_ME
PG_META_CRYPTO_KEY=CHANGE_ME
S3_PROTOCOL_ACCESS_KEY_ID=CHANGE_ME
S3_PROTOCOL_ACCESS_KEY_SECRET=CHANGE_ME
# Mot de passe du rôle Postgres limité utilisé par le service tracker
TRACKER_DB_PASSWORD=CHANGE_ME

# Accès à Supabase Studio (interface d'admin de la base)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME

# Nouveau format de clés Supabase (optionnel, laissé vide)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=


############################################
# Emails (inscription, mot de passe oublié…)
############################################

# En local : Mailpit attrape tous les emails → http://localhost:8025
# En production : un vrai serveur SMTP. Offres gratuites suffisantes :
#   Brevo (300 emails/jour), Resend (3000/mois)… voir docs/CONFIGURATION.md
SMTP_HOST=mailpit
# Port de l'interface web de Mailpit (dev) : http://localhost:8025
MAILPIT_UI_PORT=8025
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@trophytracker.local
SMTP_SENDER_NAME=TrophyTracker

# true = pas de confirmation par email (pratique en dev, à éviter en production)
ENABLE_EMAIL_AUTOCONFIRM=false
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
JWT_EXPIRY=3600

MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Paiement de l'accès équipage par Stripe — voir docs/PAIEMENT.md
# Laisser vide tant que le compte Stripe n'est pas prêt : le site affiche « paiement bientôt disponible ».
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Journal de bord : brouillon du soir rédigé par Claude (https://platform.claude.com).
# Vide = le site propose un brouillon simple, sans IA.
ANTHROPIC_API_KEY=


############################################
# Traccar (optionnel)
############################################
# Si vous avez un serveur Traccar, le service tracker y récupère les positions
# des appareils associés aux équipages. Sinon, les téléphones peuvent envoyer
# directement leurs positions (voir docs/GPS.md) : laissez vide.
TRACCAR_URL=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
TRACCAR_POLL_SECONDS=10


############################################
# Réglages internes Supabase (valeurs par défaut conseillées)
############################################

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Port de la machine hôte pour se connecter à Postgres (via le pooler), ex. avec DBeaver.
# Changez-le si un PostgreSQL local occupe déjà 5432.
POOLER_HOST_PORT=5432
API_GW_HTTP_PORT=8000
KONG_HTTP_PORT=8000

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=trophytracker
POOLER_DB_POOL_SIZE=5

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

STUDIO_DEFAULT_ORGANIZATION=TrophyTracker
STUDIO_DEFAULT_PROJECT=TrophyTracker
OPENAI_API_KEY=

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true

FUNCTIONS_VERIFY_JWT=false
