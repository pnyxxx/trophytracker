# ═════════════════════════════════════════════════════════════════════════════
#  Caddy : unique point d'entrée public de TrophyTracker.
#   - sert le site (fichiers statiques de Vite) ;
#   - relaie /auth, /rest, /storage, /realtime vers Supabase (même origine = pas de CORS) ;
#   - relaie /ingest vers le service GPS ;
#   - HTTPS automatique (Let's Encrypt) dès que SITE_ADDRESS est un nom de domaine.
# ═════════════════════════════════════════════════════════════════════════════
{
	admin off
	# Derrière un tunnel (Tailscale Funnel, Cloudflare Tunnel…), les requêtes arrivent d'une adresse privée :
	# on lit alors la vraie IP du visiteur dans X-Forwarded-For. Sans ça, tous les téléphones partageraient
	# la même IP et la limite du service GPS (300 requêtes/min par IP) s'appliquerait à tous ensemble.
	servers {
		trusted_proxies static private_ranges
	}
}

# Réseau interne Docker uniquement : Supabase Auth vient y chercher les modèles d'emails…
http://web {
	root * /srv
	@templates path /email-templates/*
	handle @templates {
		file_server
	}
	# … et le service tracker les modèles HTML des pages équipage.
	@shells path /_shell/*
	handle @shells {
		file_server
	}
	respond 404
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		# Sécurité navigateur
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Seules nos ressources + les tuiles de carte sont autorisées : bloque les injections de scripts.
		# (OpenFreeMap : fond de carte ; Esri : imagerie satellite ; s3.amazonaws.com : relief de l'accueil)
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://server.arcgisonline.com https://s3.amazonaws.com; connect-src 'self' https://photon.komoot.io https://tiles.openfreemap.org https://server.arcgisonline.com https://s3.amazonaws.com; font-src 'self' data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Pause du service (SITE_PAUSED=true) : toute requête venue d'Internet (par le tunnel Cloudflare, qui ajoute
	# Cf-Connecting-IP) reçoit la page « pause », API et réception GPS comprises. Un accès direct au serveur
	# (tunnel SSH) voit toujours le vrai site, pour l'administration.
	@paused {
		expression `"{$SITE_PAUSED:false}" == "true"`
		header Cf-Connecting-IP *
		not path /pause.html /pause/* /favicon.svg
	}
	rewrite @paused /pause.html
	header @paused X-Robots-Tag "noindex"

	# Configuration publique lue par le site (clé ANON = publique par conception).
	handle /config.js {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		respond `window.__TT_CONFIG__ = { anonKey: "{$ANON_KEY}", googleEnabled: {$GOOGLE_ENABLED:false}, paymentsEnabled: "{$PAYMENTS_ENABLED}" === "true", lanIp: "{$HOST_LAN_IP}", lanPort: "{$WEB_HTTP_PORT:80}" };`
	}

	# API Supabase
	@supabase path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/* /functions/v1/*
	handle @supabase {
		# Les réponses de l'API n'ont rien à faire dans Google.
		header X-Robots-Tag "noindex"
		reverse_proxy api-gw:8000
	}

	# Plan du site pour Google : généré par le service tracker à partir des équipages publics.
	handle /sitemap.xml {
		reverse_proxy tracker:3000
	}

	# Positions envoyées par les téléphones (Traccar Client)
	handle /ingest/* {
		reverse_proxy tracker:3000
	}

	# Site web (application React). Chaque adresse reçoit un HTML qui porte déjà son titre, sa description et
	# son adresse canonique (apps/web/seo-plugin.ts) : Google et les aperçus de partage n'ont pas à exécuter
	# le JavaScript. Une adresse inconnue répond « 404 » (sinon Google la prend pour une vraie page).
	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# /equipages/ → /equipages : une seule adresse par page.
		@trailing path_regexp trailing ^(.+)/$
		redir @trailing {re.trailing.1}{?query} 301

		# Page d'un équipage : HTML complété par le service tracker (nom, description, photo).
		# S'il ne répond pas correctement, coquille neutre : le JavaScript affiche quand même la page.
		@crew path_regexp ^/equipages/[^/]+$
		handle @crew {
			reverse_proxy tracker:3000 {
				@failed status 5xx
				handle_response @failed {
					rewrite * /_shell/app.html
					header Cache-Control "no-cache"
					file_server {
						status 200
					}
				}
			}
		}

		# Fichiers du site et pages fixes pré-générées (/ → index.html, /equipages → equipages.html).
		# Les modèles restent internes.
		@file {
			not path /_shell/*
			file {path} {path}.html {path}index.html
		}
		handle @file {
			# « route » garde cet ordre : l'en-tête dépend du fichier choisi par la réécriture.
			route {
				rewrite * {file_match.relative}
				@html path / *.html
				header @html Cache-Control "no-cache"
				file_server
			}
		}

		# Pages affichées par le JavaScript seul (comptes, connexion…), qui portent la consigne « noindex ».
		# ⚠️ À tenir à jour avec les routes de apps/web/src/App.tsx.
		@app path /connexion /inscription /mot-de-passe-oublie /nouveau-mot-de-passe /invitation /mon-compte /mon-compte/* /admin
		handle @app {
			rewrite * /_shell/app.html
			header Cache-Control "no-cache"
			file_server
		}

		# Tout le reste n'existe pas : coquille neutre (le site affiche « Page introuvable ») avec le statut 404.
		handle {
			rewrite * /_shell/app.html
			header Cache-Control "no-cache"
			file_server {
				status 404
			}
		}
	}

	# Service tracker injoignable (redémarrage…) : les pages équipage s'affichent quand même.
	handle_errors 502 503 504 {
		@crew path_regexp ^/equipages/[^/]+$
		handle @crew {
			root * /srv
			rewrite * /_shell/app.html
			header Cache-Control "no-cache"
			file_server {
				status 200
			}
		}
	}
}
