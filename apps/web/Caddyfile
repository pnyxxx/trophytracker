# ═════════════════════════════════════════════════════════════════════════════
#  Caddy : unique point d'entrée public de TrophysTracker.
#   - sert le site (fichiers statiques de Vite) ;
#   - relaie /auth, /rest, /storage, /realtime vers Supabase (même origine = pas de CORS) ;
#   - relaie /ingest vers le service GPS ;
#   - HTTPS automatique (Let's Encrypt) dès que SITE_ADDRESS est un nom de domaine.
# ═════════════════════════════════════════════════════════════════════════════
{
	admin off
}

# Réseau interne Docker uniquement : Supabase Auth vient y chercher les modèles d'emails.
http://web {
	root * /srv
	@templates path /email-templates/*
	handle @templates {
		file_server
	}
	respond 404
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		# Sécurité navigateur
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Seules nos ressources + les tuiles de carte sont autorisées : bloque les injections de scripts.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org; font-src 'self' data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Configuration publique lue par le site (clé ANON = publique par conception).
	handle /config.js {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		respond `window.__TT_CONFIG__ = { anonKey: "{$ANON_KEY}", googleEnabled: {$GOOGLE_ENABLED:false} };`
	}

	# API Supabase
	@supabase path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/* /functions/v1/*
	handle @supabase {
		reverse_proxy api-gw:8000
	}

	# Positions envoyées par les téléphones (Traccar Client)
	handle /ingest/* {
		reverse_proxy tracker:3000
	}

	# Site web (application React) : toute URL inconnue renvoie index.html.
	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
