{
  "name": "@trophytracker/tracker",
  "private": true,
  "version": "2.0.0",
  "description": "Service GPS : synchronisation Traccar + réception directe des positions (Traccar Client)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "seed:demo": "tsx --env-file-if-exists=.env src/scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@supabase/supabase-js": "^2.117.1",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
